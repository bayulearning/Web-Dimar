# ============================================================
# STRIDE ATHLETICS - ENVIRONMENT EXAMPLE
# Copy nilai yang dibutuhkan ke server/.env (jangan commit .env).
# ============================================================

# --- Application ---
NODE_ENV=development
PORT=3000
# URL publik frontend untuk canonical, Open Graph, robots.txt, dan sitemap.xml.
SITE_URL=http://localhost:5173
CLIENT_ORIGIN=http://localhost:5173

# --- Database ---
# Development: SQLite (path relatif terhadap folder server/prisma)
DATABASE_URL="file:./dev.db"
# Production: PostgreSQL
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/stride?schema=public"

# --- Authentication ---
JWT_SECRET=replace-with-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=stride_token

# --- Midtrans (Sandbox) ---
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# --- Integrasi eksternal (mock saat development) ---
SHIPPING_PROVIDER=mock

# --- Order ---
# Batas waktu pembayaran order (jam)
ORDER_EXPIRY_HOURS=24

# --- Email (development) ---
# Mode "log" mencatat email ke log server. Adapter SMTP nyata belum terpasang.
EMAIL_MODE=log
EMAIL_FROM=no-reply@stride.local
STORE_EMAIL=hello@stride.local
